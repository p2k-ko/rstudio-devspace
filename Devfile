version: v2beta1
name: rstudio-dev

# Definition des Images
images:
  rstudio:
    image: ghcr.io/p2k-ko/rstudio-devspace:0.0.1
    dockerfile: ./Containerfile

# Bereitstellung im Cluster (z.B. via einfachem Kubernetes-Manifest oder Helm)
deployments:
  rstudio-app:
    helm:
      componentChart: true
      values:
        containers:
          - image: ghcr.io/p2k-ko/rstudio-devspace:0.0.1
            env:
              - name: PASSWORD
                value: "meinSicheresPasswort" # RStudio benötigt standardmäßig ein Passwort
            ports:
              - port: 8787

# Entwicklungs-Modus (Sync & Port-Forwarding)
dev:
  rstudio:
    labelSelector:
      app.kubernetes.io/component: rstudio-app
    forward:
      - port: 8787 # Leitet den Cluster-Port an localhost:8787 weiter
    sync:
      - path: ./:/home/rstudio/project # Synchronisiert Ihren lokalen Code direkt in das RStudio-Verzeichnis